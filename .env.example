# 项目默认使用百炼 embedding 与 DeepSeek chat；填写各自 API key 后启用。离线词面检索可将 embedding provider 改为 local_hash。
PAPERTRAIL_DATA_DIR=./var
# OCR is optional. Its pinned CPU packages and bundled ONNX models live only in
# var/ocr_packages. Enable after installing apps/api/requirements-ocr.txt there.
PAPERTRAIL_OCR_ENABLED=false
PAPERTRAIL_OCR_DPI=150
PAPERTRAIL_OCR_MAX_PAGES=50
PAPERTRAIL_DATABASE_URL=sqlite:///./var/papertrail.db
# 项目使用阿里云百炼 OpenAI-compatible embedding API。
PAPERTRAIL_EMBEDDING_PROVIDER=openai
PAPERTRAIL_EMBEDDING_MODEL=text-embedding-v4
PAPERTRAIL_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
PAPERTRAIL_EMBEDDING_API_KEY=
# Chat 使用 DeepSeek OpenAI-compatible API，密钥与 embedding 独立。
PAPERTRAIL_LLM_BASE_URL=https://api.deepseek.com/v1
PAPERTRAIL_LLM_MODEL=deepseek-flash
PAPERTRAIL_LLM_API_KEY=
# HTTPX Chat response-read limit (seconds); connect/write/pool remain 10/30/10 seconds.
PAPERTRAIL_LLM_READ_TIMEOUT_SECONDS=180
# Finite completion ceiling for answer, verifier, repair-query and revision calls.
PAPERTRAIL_LLM_MAX_TOKENS=16384
